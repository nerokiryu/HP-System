{{! Features Tab }}
<section
  class='tab features scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='features'
>
  <div class='features-layout'>
    <div class='features-column'>
      <h3>{{localize 'HOGWARTS.Actor.Tabs.Features'}}</h3>
      <div class='abilities flexcol'>
        {{#each system.stats as |stat key|}}
          <div class='ability flexrow flex-group-center'>
            <label
              class='resource-label flexlarge align-left'
            >{{localize (lookup @root.config.stats key)}}</label>
            <input
              type='number'
              name='system.stats.{{key}}.value'
              value='{{stat.value}}'
              class="ability-score"
              min='1'
              step='1'
              data-dtype='Number'
            />
            {{#if stat.hybridMod}}
              <span
                class='hybrid-mod {{#if (gt stat.hybridMod 0)}}bonus{{else}}malus{{/if}}'
                data-tooltip='{{localize "HOGWARTS.Hybrid.StatTooltip"}}'
              >{{#if (gt stat.hybridMod 0)}}+{{/if}}{{stat.hybridMod}} = {{stat.total}}</span>
            {{/if}}
            <span
              class='ability-mod rollable'
              data-action='roll'
              data-roll='1d100'
              data-target='@checks.{{key}}'
              data-label='{{localize (lookup @root.config.stats key)}}'
            >×5: {{lookup @root.system.checks key}}</span>
          </div>
        {{/each}}
      </div>

      {{#if (eq actor.type 'familiar')}}
      <div class='familiar-pbp-total'>
        <label class='resource-label'>{{localize 'HOGWARTS.Actor.Familiar.TotalPBPCost'}}</label>
        <div class='resource-content'>
          <span class='total-pbp'>{{totalPbpCost}}</span>
        </div>
      </div>
      {{/if}}

      {{#if hybrid}}
      <div class='hybrid-block'>
        <h3>{{localize 'HOGWARTS.Hybrid.Title'}}</h3>

        <div class='hybrid-row'>
          <label>{{localize 'HOGWARTS.Hybrid.Ancestor'}}</label>
          <select name='system.hybrid.race'>
            <option value=''>{{localize 'HOGWARTS.Hybrid.None'}}</option>
            {{#each hybrid.races as |r|}}
              <option value='{{r.key}}' {{#if r.selected}}selected{{/if}}>{{r.label}}</option>
            {{/each}}
          </select>
        </div>

        {{#if system.hybrid.race}}
          <div class='hybrid-row'>
            <label>{{localize 'HOGWARTS.Hybrid.Generation.Label'}}</label>
            <select name='system.hybrid.generation'>
              <option value=''>—</option>
              {{#each hybrid.generations as |g|}}
                <option value='{{g.key}}' {{#if g.selected}}selected{{/if}}>{{g.label}}</option>
              {{/each}}
            </select>
            {{#if hybrid.cost}}
              <span class='hybrid-cost'>{{localize 'HOGWARTS.Hybrid.Cost'}}: {{hybrid.cost}}</span>
            {{/if}}
          </div>

          {{#if hybrid.bonusChoices.length}}
            <div class='hybrid-row'>
              <label>{{localize 'HOGWARTS.Hybrid.PickBonus'}}</label>
              <select name='system.hybrid.pickBonus'>
                <option value=''>—</option>
                {{#each hybrid.bonusChoices as |c|}}
                  <option value='{{c.stat}}' {{#if c.selected}}selected{{/if}}>{{c.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if}}

          {{#if hybrid.malusChoices.length}}
            <div class='hybrid-row'>
              <label>{{localize 'HOGWARTS.Hybrid.PickMalus'}}</label>
              <select name='system.hybrid.pickMalus'>
                <option value=''>—</option>
                {{#each hybrid.malusChoices as |c|}}
                  <option value='{{c.stat}}' {{#if c.selected}}selected{{/if}}>{{c.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if}}

          {{#if hybrid.capabilityChoices.length}}
            <div class='hybrid-row'>
              <label>{{localize 'HOGWARTS.Hybrid.PickCapability'}}</label>
              <select name='system.hybrid.pickCapability'>
                <option value=''>—</option>
                {{#each hybrid.capabilityChoices as |c|}}
                  <option value='{{c.option}}' {{#if c.selected}}selected{{/if}}>{{c.option}}</option>
                {{/each}}
              </select>
            </div>
          {{/if}}

          {{#if hybrid.offersYumboe}}
            <div class='hybrid-row'>
              <label>{{localize 'HOGWARTS.Hybrid.Capability.Yumboe'}}</label>
              <input type='checkbox' name='system.hybrid.yumboe' {{checked system.hybrid.yumboe}} />
              <span class='hybrid-cost'>+0.5</span>
            </div>
          {{/if}}

          {{#if hybrid.capabilities.length}}
            <ul class='hybrid-capabilities'>
              {{#each hybrid.capabilities as |c|}}
                <li>{{c.label}}{{#if c.note}} <span class='note'>({{c.note}})</span>{{/if}}</li>
              {{/each}}
            </ul>
          {{/if}}
        {{/if}}
      </div>
      {{/if}}
    </div>

    <div class='features-column'>
      <h3>{{localize 'HOGWARTS.Derived.Title'}}</h3>
      <div class='abilities flexcol'>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Taste'}}</label>
          <span class='ability-value'>{{system.derived.taste}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.taste}}' data-label='{{localize "HOGWARTS.Derived.Taste"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Smell'}}</label>
          <span class='ability-value'>{{system.derived.smell}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.smell}}' data-label='{{localize "HOGWARTS.Derived.Smell"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Hearing'}}</label>
          <span class='ability-value'>{{system.derived.hearing}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.hearing}}' data-label='{{localize "HOGWARTS.Derived.Hearing"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Touch'}}</label>
          <span class='ability-value'>{{system.derived.touch}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.touch}}' data-label='{{localize "HOGWARTS.Derived.Touch"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Sight'}}</label>
          <span class='ability-value'>{{system.derived.sight}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.sight}}' data-label='{{localize "HOGWARTS.Derived.Sight"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Idea'}}</label>
          <span class='ability-value'>{{system.derived.idea}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.idea}}' data-label='{{localize "HOGWARTS.Derived.Idea"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
        <div class='ability flexrow flex-group-center'>
          <label class='resource-label flexlarge align-left'>{{localize 'HOGWARTS.Derived.Luck'}}</label>
          <span class='ability-value'>{{system.derived.luck}}</span>
          <span class='ability-mod rollable' data-action='roll' data-roll='1d100' data-target='{{system.derived.luck}}' data-label='{{localize "HOGWARTS.Derived.Luck"}}'>
            <i class='fas fa-dice-d20'></i>
          </span>
        </div>
      </div>
    </div>
  </div>

  {{#unless (eq actor.type "familiar")}}
  <div class='wounds-full-width'>
    <h3>{{localize 'HOGWARTS.Wounds.Title'}}</h3>
    <div class='wounds-section flexrow'>
      <div class='wounds-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Wounds.NonLethal'}}</label>
        <div class='resource-content flexrow flex-group-center'>
          <input type='number' name='system.healthNonLethal.value' value='{{system.healthNonLethal.value}}' data-dtype='Number' min='0' class='wound-input' />
          <span class='experience-separator'>/</span>
          <span class='wound-max'>{{system.healthNonLethal.max}}</span>
        </div>
      </div>
      <div class='wounds-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Wounds.SeriousWound'}}</label>
        <div class='resource-content flexrow flex-group-center'>
          <input type='checkbox' name='system.conditions.seriousWound' {{#if system.conditions.seriousWound}}checked{{/if}} />
        </div>
      </div>
      <div class='wounds-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Wounds.Agony'}}</label>
        <div class='resource-content flexrow flex-group-center'>
          <input type='checkbox' name='system.conditions.agony' {{#if system.conditions.agony}}checked{{/if}} />
        </div>
      </div>
      <div class='wounds-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Actor.Character.Stress'}}</label>
        <div class='resource-content flexrow flex-group-center'>
          <input type='number' name='system.stress.value' value='{{system.stress.value}}' data-dtype='Number' min='0' max='25' class='wound-input' />
          <span class='experience-separator'>%</span>
        </div>
      </div>
    </div>
  </div>
  <div class='experience-full-width'>
    <h3>{{localize 'HOGWARTS.Experience.Title'}}</h3>
    <div class='experience-section'>
      <div class='experience-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Experience.CreationPoints'}}</label>
        <div class='experience-values'>
          {{#if creationPointsCurrentDefined}}
            <span class='experience-current {{#if creationPointsCurrentNegative}}negative{{/if}}' aria-live='polite' aria-atomic='true'>
              {{creationPointsCurrent}}
              {{#if creationPointsCurrentNegative}}<i class='fas fa-exclamation-triangle alert-icon' title='{{localize "HOGWARTS.Common.Negative"}}' aria-hidden='true'></i>{{/if}}
            </span>
          {{else}}
            <span class='experience-current'>{{subtract system.experience.creationPoints.max system.experience.creationPoints.spent}}</span>
          {{/if}}
          <span class='experience-separator'>/</span>
          <input
            type='number'
            name='system.experience.creationPoints.max'
            value='{{system.experience.creationPoints.max}}'
            class='experience-max'
            min='0' step='1'
            data-dtype='Number'
          />
        </div>
      </div>
      <div class='experience-item'>
        <label class='resource-label'>{{localize 'HOGWARTS.Experience.PersonalBonusPoints'}}</label>
        <div class='experience-values'>
          {{#if personalBonusCurrentDefined}}
            <span class='experience-current {{#if personalBonusCurrentNegative}}negative{{/if}}' aria-live='polite' aria-atomic='true'>
              {{personalBonusCurrent}}
              {{#if personalBonusCurrentNegative}}<i class='fas fa-exclamation-triangle alert-icon' title='{{localize "HOGWARTS.Common.Negative"}}' aria-hidden='true'></i>{{/if}}
            </span>
          {{else}}
            <span class='experience-current'>{{subtract system.experience.personalBonusPoints.max system.experience.personalBonusPoints.spent}}</span>
          {{/if}}
          <span class='experience-separator'>/</span>
          <input
            type='number'
            name='system.experience.personalBonusPoints.max'
            value='{{system.experience.personalBonusPoints.max}}'
            class='experience-max'
            min='0' step='1'
            data-dtype='Number'
          />
        </div>
      </div>
    </div>
  </div>
  {{/unless}}
</section>