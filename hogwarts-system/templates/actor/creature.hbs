{{!-- Creature Stats & Combat Tab --}}
<section class='tab creature scrollable {{tab.cssClass}}' data-group='primary' data-tab='creature'>

  {{!-- Classification --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='classification'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Classification"}}
    </h3>
    <div class='creature-section-content' data-section='classification'>
      <div class='form-group'>
        <select name="system.classification" data-dtype="String">
          <option value="X" {{#if (eq system.classification 'X')}}selected{{/if}}>X — {{localize "HOGWARTS.Actor.Creature.ClassX"}}</option>
          <option value="XX" {{#if (eq system.classification 'XX')}}selected{{/if}}>XX — {{localize "HOGWARTS.Actor.Creature.ClassXX"}}</option>
          <option value="XXX" {{#if (eq system.classification 'XXX')}}selected{{/if}}>XXX — {{localize "HOGWARTS.Actor.Creature.ClassXXX"}}</option>
          <option value="XXXX" {{#if (eq system.classification 'XXXX')}}selected{{/if}}>XXXX — {{localize "HOGWARTS.Actor.Creature.ClassXXXX"}}</option>
          <option value="XXXXX" {{#if (eq system.classification 'XXXXX')}}selected{{/if}}>XXXXX — {{localize "HOGWARTS.Actor.Creature.ClassXXXXX"}}</option>
        </select>
      </div>
    </div>
  </div>

  {{!-- Stats --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='stats'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Stats"}}
    </h3>
    <div class='creature-section-content' data-section='stats'>
      <div class='stats-grid grid grid-4col'>
        {{#each system.stats as |stat key|}}
        <div class='stat-block flex-group-center'>
          <label class='stat-label rollable' data-action="rollCreatureStat" data-stat="{{key}}" data-tooltip="{{localize 'HOGWARTS.Chat.Roll'}}: {{stat.label}} ×5">{{stat.label}}</label>
          <input type="number" name="system.stats.{{key}}.value" value="{{stat.value}}" data-dtype="Number" min="0" />
          <input type="text" name="system.stats.{{key}}.formula" value="{{stat.formula}}" placeholder="ex: 3d6+6" class="stat-formula" />
        </div>
        {{/each}}
      </div>

      {{!-- Derived Values inline --}}
      <div class='derived-row grid grid-4col'>
        <div class='derived-block flex-group-center'>
          <label class='rollable' data-action="rollDamageBonus" data-tooltip="{{localize 'HOGWARTS.Chat.Roll'}}: {{localize 'HOGWARTS.Actor.Creature.DamageBonus'}}">{{localize "HOGWARTS.Actor.Creature.DamageBonus"}}</label>
          <span class='derived-value rollable' data-action="rollDamageBonus">{{system.damageBonus}}</span>
        </div>
        <div class='derived-block flex-group-center'>
          <label>{{localize "HOGWARTS.Actor.Creature.Luck"}}</label>
          <span class='derived-value'>{{system.luck}}%</span>
        </div>
        <div class='derived-block flex-group-center'>
          <label>{{localize "HOGWARTS.Actor.Creature.MagicResistance"}}</label>
          <div class='flexrow flex-center'>
            <input type="number" name="system.magicResistance.threshold" value="{{system.magicResistance.threshold}}" data-dtype="Number" min="0" max="100" />
            <span>%</span>
          </div>
        </div>
        <div class='derived-block flex-group-center'>
          <label>{{localize "HOGWARTS.Actor.Creature.EffectReduction"}}</label>
          <input type="number" name="system.magicResistance.effectReduction" value="{{system.magicResistance.effectReduction}}" data-dtype="Number" min="0" step="0.5" />
        </div>
      </div>
    </div>
  </div>

  {{!-- Movement & Armor --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='movement'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Movement"}} / {{localize "HOGWARTS.Actor.Creature.Armor"}}
    </h3>
    <div class='creature-section-content' data-section='movement'>
      <div class='grid grid-5col'>
        <div class='form-group'>
          <label>{{localize "HOGWARTS.Actor.Creature.MovementLand"}}</label>
          <input type="number" name="system.movement.land" value="{{system.movement.land}}" data-dtype="Number" min="0" />
        </div>
        <div class='form-group'>
          <label>{{localize "HOGWARTS.Actor.Creature.MovementFly"}}</label>
          <input type="number" name="system.movement.fly" value="{{system.movement.fly}}" data-dtype="Number" min="0" />
        </div>
        <div class='form-group'>
          <label>{{localize "HOGWARTS.Actor.Creature.MovementSwim"}}</label>
          <input type="number" name="system.movement.swim" value="{{system.movement.swim}}" data-dtype="Number" min="0" />
        </div>
        <div class='form-group'>
          <label>{{localize "HOGWARTS.Actor.Creature.ArmorValue"}}</label>
          <input type="number" name="system.armor.value" value="{{system.armor.value}}" data-dtype="Number" min="0" />
        </div>
        <div class='form-group'>
          <label>{{localize "HOGWARTS.Actor.Creature.ArmorLabel"}}</label>
          <input type="text" name="system.armor.label" value="{{system.armor.label}}" />
        </div>
      </div>
    </div>
  </div>

  {{!-- Attacks --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='attacks'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Attacks"}}
      <a class='item-control' data-action="addAttack" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.AddAttack'}}">
        <i class='fas fa-plus'></i>
      </a>
    </h3>
    <div class='creature-section-content' data-section='attacks'>
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>{{localize "HOGWARTS.Actor.Creature.AttackName"}}</div>
          <div class='item-prop'>%</div>
          <div class='item-prop'>{{localize "HOGWARTS.Actor.Creature.Damage"}}</div>
          <div class='item-controls'></div>
        </li>
        {{#each system.attacks as |attack idx|}}
        <li class='item flexrow' data-index="{{idx}}">
          <div class='item-name'>
            <input type="text" name="system.attacks.{{idx}}.name" value="{{attack.name}}" placeholder="{{localize 'HOGWARTS.Actor.Creature.AttackName'}}" />
          </div>
          <div class='item-prop'>
            <input type="number" name="system.attacks.{{idx}}.chance" value="{{attack.chance}}" data-dtype="Number" min="0" max="100" />
          </div>
          <div class='item-prop'>
            <input type="text" name="system.attacks.{{idx}}.damage" value="{{attack.damage}}" placeholder="1d6" />
          </div>
          <div class='item-controls'>
            <a class='item-control rollable' data-action="rollAttack" data-index="{{idx}}" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.RollAttack'}}">
              <i class='fas fa-dice-d20'></i>
            </a>
            <a class='item-control' data-action="deleteAttack" data-index="{{idx}}" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.DeleteAttack'}}">
              <i class='fas fa-trash'></i>
            </a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>

  {{!-- Skills --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='skills'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Skills"}}
      <a class='item-control' data-action="addCreatureSkill" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.AddSkill'}}">
        <i class='fas fa-plus'></i>
      </a>
    </h3>
    <div class='creature-section-content' data-section='skills'>
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>{{localize "HOGWARTS.Name"}}</div>
          <div class='item-prop'>{{localize "HOGWARTS.Skills.Value"}}</div>
          <div class='item-controls'></div>
        </li>
        {{#each system.skills as |skill idx|}}
        <li class='item flexrow' data-index="{{idx}}">
          <div class='item-name'>
            <input type="text" name="system.skills.{{idx}}.name" value="{{skill.name}}" />
          </div>
          <div class='item-prop'>
            <input type="number" name="system.skills.{{idx}}.value" value="{{skill.value}}" data-dtype="Number" min="0" max="100" />
            <span>%</span>
          </div>
          <div class='item-controls'>
            <a class='item-control rollable' data-action="rollCreatureSkill" data-index="{{idx}}" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.RollSkill'}}">
              <i class='fas fa-dice-d20'></i>
            </a>
            <a class='item-control' data-action="deleteCreatureSkill" data-index="{{idx}}" data-tooltip="{{localize 'HOGWARTS.Actor.Creature.DeleteSkill'}}">
              <i class='fas fa-trash'></i>
            </a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>

  {{!-- Powers & Abilities --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='powers'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Powers"}}
    </h3>
    <div class='creature-section-content' data-section='powers'>
      {{formField systemFields.powers value=system.powers}}
    </div>
  </div>

  {{!-- Usage --}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='usage'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Creature.Usage"}}
    </h3>
    <div class='creature-section-content' data-section='usage'>
      {{formField systemFields.usage value=system.usage}}
    </div>
  </div>

  {{!-- GM Notes --}}
  {{#if isGM}}
  <div class='creature-section'>
    <h3 class='collapsible' data-action='toggleCreatureSection' data-section='gmNotes'>
      <i class='fas fa-chevron-down'></i>
      {{localize "HOGWARTS.Actor.Character.GMNotes"}}
    </h3>
    <div class='creature-section-content' data-section='gmNotes'>
      {{formField systemFields.notes.fields.gmNotes value=system.notes.gmNotes}}
    </div>
  </div>
  {{/if}}

</section>
