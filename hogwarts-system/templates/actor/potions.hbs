{{! Potions Tab }}
<section
  class='tab potions scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='potions'
>
  <div class='item-drop-target' data-drop-type='potion'>
  <ol class='items-list'>
    {{#each potions as |potions potionLevel|}}
      <li class='item flexrow items-header'>
        <div class='item-name'>
          {{#if (eq potionLevel '6')}}
            {{localize 'HOGWARTS.Item.Potion.PotionLVL' level='5+'}}
          {{else}}
            {{localize 'HOGWARTS.Item.Potion.PotionLVL' level=potionLevel}}
          {{/if}}
        </div>
        <div class='item-target'>{{localize 'HOGWARTS.Item.Potion.FIELDS.target.label'}}</div>
        <div class='item-malus'>{{localize 'HOGWARTS.Item.Potion.FIELDS.malus.label'}}</div>
        <div class='item-qty-header'>{{localize 'HOGWARTS.Item.Potion.Qty'}}</div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a
              class='item-control item-create'
              data-tooltip='{{localize "DOCUMENT.Create" type='Potion'}}'
              data-action='createDoc'
              data-document-class='Item'
              data-type='potion'
              data-system.potion-level='{{potionLevel}}'
            >
              <i class='fas fa-plus'></i>
              {{#if (eq potionLevel '6')}}
                {{localize 'HOGWARTS.Item.Potion.AddLVL' level='5+'}}
              {{else}}
                {{localize 'HOGWARTS.Item.Potion.AddLVL' level=potionLevel}}
              {{/if}}
            </a>
          {{/if}}
        </div>
      </li>
      {{#each potions as |item id|}}
        <li
          class='item flexrow draggable'
          data-item-id='{{item._id}}'
          data-document-class='Item'
        >
          <div class='item-name flexrow'>
            <div class='item-image'>
              <a class='rollable' data-roll-type='potion' data-action='rollPotion' data-item-id='{{item._id}}'>
                <img
                  src='{{item.img}}'
                  data-tooltip='{{item.name}}'
                  width='24'
                  height='24'
                />
              </a>
            </div>
            <div>{{item.name}}</div>
          </div>
          <div class='item-target'>{{item.system.targetDisplay}}</div>
          <div class='item-malus'>{{item.system.malus}}</div>
          <div class='item-qty'>
            <span class='potion-qty-value'>{{item.system.quantity}}</span>
          </div>
          <div class='item-controls'>
            {{#if @root.editable}}
              <a
                class='item-control'
                data-tooltip='{{localize "HOGWARTS.Item.Potion.Brew"}}'
                data-action='brewPotion'
                data-item-id='{{item._id}}'
              >
                <i class='fas fa-flask'></i>
              </a>
              <a
                class='item-control {{#unless item.system.quantity}}disabled{{/unless}}'
                data-tooltip='{{localize "HOGWARTS.Item.Potion.Use"}}'
                data-action='usePotion'
                data-item-id='{{item._id}}'
              >
                <i class='fas fa-wine-bottle'></i>
              </a>
            {{/if}}
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type='potion'}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>
            {{#if @root.editable}}
              <a
                class='item-control item-delete'
                data-tooltip='{{localize "DOCUMENT.Delete" type='potion'}}'
                data-action='deleteDoc'
              >
                <i class='fas fa-trash'></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    {{/each}}
  </ol>
  </div>

</section>
