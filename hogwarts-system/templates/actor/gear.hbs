{{! Gear Tab }}
<section class='tab gear scrollable {{tab.cssClass}}' data-group='primary' data-tab='gear'>
  
  {{! Wand Section }}
  <div class='wand-section'>
    <h3>{{localize 'HOGWARTS.Wand.Title'}}</h3>
    <div class='wand-container'>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Wand.Wood'}}</label>
        <input type='text' name='system.wand.wood' value='{{system.wand.wood}}' placeholder='Ex: Houx' />
      </div>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Wand.Core'}}</label>
        <input type='text' name='system.wand.core' value='{{system.wand.core}}' placeholder='Ex: Plume de phénix' />
      </div>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Wand.Length'}}</label>
        <input type='text' name='system.wand.length' value='{{system.wand.length}}' placeholder='Ex: 28 cm' />
      </div>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Wand.Flexibility'}}</label>
        <input type='text' name='system.wand.flexibility' value='{{system.wand.flexibility}}' placeholder='Ex: Souple' />
      </div>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Wand.Affinity'}}</label>
        <input type='text' name='system.wand.affinity' value='{{system.wand.affinity}}' placeholder='Ex: Sorts de défense' />
      </div>
      <div class='form-group'>
        <label>{{localize 'HOGWARTS.Item.Feature.PBPCost'}}</label>
        <input type='number' name='system.wand.pbpCost' value='{{system.wand.pbpCost}}' step='0.5' />
      </div>
      <div class='form-group form-group-full'>
        <label>{{localize 'HOGWARTS.Wand.Description'}}</label>
        <textarea name='system.wand.description' rows='2' placeholder='Description de la baguette...'>{{system.wand.description}}</textarea>
      </div>
    </div>
  </div>

  {{! Brooms Section }}
  <div class='brooms-section'>
    <h3>{{localize 'TYPES.Item.broom'}}</h3>
    <div class='item-drop-target' data-drop-type='broom'>
    <ol class='items-list'>
      <li class='item flexrow items-header'>
        <div class='item-image'></div>
        <div class='item-name'>{{localize 'HOGWARTS.Name'}}</div>
        <div class='item-prop'>{{localize 'HOGWARTS.Broom.Characteristics'}}</div>
        <div class='item-pbp'>{{localize 'HOGWARTS.Broom.PBPCost'}}</div>
        <div class='item-controls'>
          {{#if @root.editable}}
            <a class='item-control' data-action='createDoc' data-document-class='Item' data-type='broom' data-tooltip='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.broom")}}'>
              <i class='fas fa-plus'></i>
            </a>
          {{/if}}
        </div>
      </li>
      {{#each brooms as |item id|}}
        <li class='item flexrow' data-item-id='{{item.id}}' data-document-class='Item'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
            </a>
          </div>
          <h4 class='item-name'>
            <a data-action='viewDoc'>{{item.name}}</a>
            {{#if item.system.brand}}
              <span class='item-brand'>({{item.system.brand}})</span>
            {{/if}}
          </h4>
          <div class='item-prop item-characteristics'>{{item.system.characteristics}}</div>
          <div class='item-pbp item-prop'>{{item.system.pbpCost}}</div>
          <div class='item-controls'>
            <a
              class='item-control item-edit'
              data-tooltip='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.broom")}}'
              data-action='viewDoc'
            >
              <i class='fas fa-edit'></i>
            </a>
            {{#if @root.editable}}
              <a
                class='item-control item-delete'
                data-tooltip='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.broom")}}'
                data-action='deleteDoc'
              >
                <i class='fas fa-trash'></i>
              </a>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
    </div>
  </div>

  {{! Currency Section }}
  <div class='currency-section'>
    <h3>{{localize 'HOGWARTS.Currency.Title'}}</h3>
    <div class='currency-container'>
      <div class='currency-item galleons'>
        <label>{{localize 'HOGWARTS.Currency.Galleons'}}</label>
        <input
          type='number'
          name='system.currency.galleons'
          value='{{system.currency.galleons}}'
          min='0'
          data-dtype='Number'
        />
        <span class='currency-icon'>🪙</span>
      </div>
      <div class='currency-item sickles'>
        <label>{{localize 'HOGWARTS.Currency.Sickles'}}</label>
        <input
          type='number'
          name='system.currency.sickles'
          value='{{system.currency.sickles}}'
          min='0'
          data-dtype='Number'
        />
        <span class='currency-icon'>🪙</span>
      </div>
      <div class='currency-item knuts'>
        <label>{{localize 'HOGWARTS.Currency.Knuts'}}</label>
        <input
          type='number'
          name='system.currency.knuts'
          value='{{system.currency.knuts}}'
          min='0'
          data-dtype='Number'
        />
        <span class='currency-icon'>🪙</span>
      </div>
    </div>
    <div class='currency-conversion'>
      <small>1 {{localize 'HOGWARTS.Currency.Galleons'}} = 17 {{localize 'HOGWARTS.Currency.Sickles'}} = 493 {{localize 'HOGWARTS.Currency.Knuts'}}</small>
    </div>
  </div>

  {{! Equipment List }}
  <div class='item-drop-target' data-drop-type='gear'>
  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'HOGWARTS.Name'}}</div>
      <div class='item-quantity'>{{localize 'HOGWARTS.Item.Gear.FIELDS.quantity.label'}}</div>
      <div class='item-weight'>{{localize 'HOGWARTS.Item.Gear.FIELDS.weight.label'}}</div>
      <div class='item-cost'>{{localize 'HOGWARTS.Item.Gear.Cost'}}</div>
      <div class='item-pbp'>{{localize 'HOGWARTS.Item.Feature.PBPCost'}}</div>
      <div class='item-controls'>
        {{#if @root.editable}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.gear")}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='gear'
          >
            <i class='fas fa-plus'></i>
          </a>
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.weapon")}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='weapon'
          >
            <i class='fas fa-fist-raised'></i>
          </a>
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.armor")}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='armor'
          >
            <i class='fas fa-shield-alt'></i>
          </a>
        {{/if}}
      </div>
    </li>
    {{#each gear as |item id|}}
      <li
        class='item flexrow draggable'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action='roll'>
              <img
                src='{{item.img}}'
                data-tooltip='{{item.name}}'
                width='24'
                height='24'
              />
            </a>
          </div>
          <div>{{item.name}}</div>
        </div>
        <div class='item-quantity item-prop'>
          {{#if @root.editable}}
            <input
              type='number'
              name='items.{{item._id}}.system.quantity'
              value='{{item.system.quantity}}'
              min='1'
              data-dtype='Number'
              class='item-quantity-input'
            />
          {{else}}
            {{item.system.quantity}}
          {{/if}}
        </div>
        <div class='item-weight item-prop'>{{item.system.weight}}</div>
        <div class='item-cost item-prop'>
          {{#if (gt item.system.cost.galleons 0)}}<span class='cost-galleons'>{{item.system.cost.galleons}}G</span>{{/if}}
          {{#if (gt item.system.cost.sickles 0)}}<span class='cost-sickles'>{{item.system.cost.sickles}}M</span>{{/if}}
          {{#if (gt item.system.cost.knuts 0)}}<span class='cost-knuts'>{{item.system.cost.knuts}}N</span>{{/if}}
          {{#unless (or (gt item.system.cost.galleons 0) (gt item.system.cost.sickles 0) (gt item.system.cost.knuts 0))}}-{{/unless}}
        </div>
        <div class='item-pbp item-prop'>{{item.system.pbpCost}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-edit'
            data-tooltip='{{localize "DOCUMENT.Update" type='Gear'}}'
            data-action='viewDoc'
          >
            <i class='fas fa-edit'></i>
          </a>
          {{#if @root.editable}}
            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type='Gear'}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
  </div>

</section>