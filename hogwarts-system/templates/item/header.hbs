<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{item.img}}'
    data-edit='img'
    data-action='onEditImage'
    data-tooltip='{{item.name}}'
  />
  <div class='header-fields'>
    <div class='document-name'>
      <input name='name' type='text' value='{{item.name}}' placeholder='Name' />
      <a class='post-to-chat' data-action='postToChat' data-tooltip='{{localize "HOGWARTS.Chat.PostToChat"}}'>
        <i class='fas fa-comment-dots'></i>
      </a>
    </div>
    {{! Type-specific fields live in the Attributes tab, not here: keeping the
        header identical for every item type stops it from resizing (and
        clipping the portrait) when switching between types and tabs. }}
  </div>
</header>