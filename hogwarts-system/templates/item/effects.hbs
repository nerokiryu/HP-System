{{! Effects Tab }}
<section class='tab effects {{tab.cssClass}}' data-group='primary' data-tab='effects'>
  <ol class='effects-list'>
    {{#each effects as |section sid|}}
      <li class='effects-header flexrow' data-effect-type='{{section.type}}'>
        <div class='effect-name effect-name flexrow'>
          {{localize section.label}}
        </div>
        <div class='effect-source'>
          {{localize 'HOGWARTS.Effect.Source'}}
        </div>
        <div class='effect-source'>{{localize 'EFFECT.TabDuration'}}</div>
        <div class='effect-controls effect-controls flexrow'>
          <a
            class='effect-control'
            data-action='createDoc'
            data-document-class='ActiveEffect'
            data-origin="{{@root.item.uuid}}"
            data-img="icons/svg/aura.svg"
            {{#if (eq section.type "inactive")}}
              data-disabled="true"
            {{else if (eq section.type "temporary")}}
              data-duration.rounds="1"
            {{/if}}
            data-tooltip='{{localize "DOCUMENT.Create" type='Effect'}}'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='Effect'}}
          </a>
        </div>
      </li>
      <ol class='effect-list'>
        {{#each section.effects as |effect|}}
          <li
            class='item effect flexrow draggable'
            data-effect-id='{{effect.id}}'
            data-parent-id='{{effect.parent.id}}'
          >
            <div class='effect-name effect-name flexrow'>
              <img class='effect-image' src='{{effect.img}}' height="24" width="24"/>
              <div>{{effect.name}}</div>
            </div>
            <div class='effect-source'>{{effect.sourceName}}</div>
            <div class='effect-duration'>{{effect.duration.label}}</div>
            <div class='effect-controls effect-controls flexrow'>
              {{#if @root.editable}}
              <a
                class='effect-control'
                data-action='toggleEffect'
                data-tooltip='{{localize "HOGWARTS.Effect.Toggle"}}'
              >
                <i class='fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}'></i>
              </a>
              {{/if}}
              <a
                class='effect-control'
                data-action='viewDoc'
                data-document-class='ActiveEffect'
                data-tooltip='{{localize "DOCUMENT.Update" type='Effect'}}'
              >
                <i class='fas fa-edit'></i>
              </a>
              {{#if @root.editable}}
              <a
                class='effect-control'
                data-action='deleteDoc'
                data-document-class='ActiveEffect'
                data-tooltip='{{localize "DOCUMENT.Delete" type='Effect'}}'
              >
                <i class='fas fa-trash'></i>
              </a>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ol>
    {{/each}}
  </ol>

  <details class='effect-attr-reference'>
    <summary>{{localize 'HOGWARTS.Effect.AttributeReference'}}</summary>
    <p class='effect-attr-hint'>{{localize 'HOGWARTS.Effect.AttributeReferenceHint'}}</p>
    <ol class='effect-attr-list'>
      <li class='effect-attr-row effect-attr-head flexrow'>
        <div class='effect-attr-key'>{{localize 'HOGWARTS.Effect.AttributeKey'}}</div>
        <div class='effect-attr-value'>{{localize 'HOGWARTS.Effect.AttributeValue'}}</div>
        <div class='effect-attr-copy'></div>
      </li>
      {{#each effectAttributes as |attr|}}
        <li class='effect-attr-row flexrow'>
          <div class='effect-attr-key'><code>{{attr.key}}</code></div>
          <div class='effect-attr-value'>{{attr.value}}</div>
          <div class='effect-attr-copy'>
            <a
              data-action='copyEffectKey'
              data-key='{{attr.key}}'
              data-tooltip='{{localize "HOGWARTS.Effect.CopyKey"}}'
            >
              <i class='fas fa-copy'></i>
            </a>
          </div>
        </li>
      {{/each}}
    </ol>
  </details>
</section>