{{! Attributes Tab }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  <div class='form-group'>
    <label>{{localize 'HOGWARTS.Item.Feature.FIELDS.perkType.label'}}</label>
    <select name='system.perkType'>
      <option value='' {{#unless system.perkType}}selected{{/unless}}>{{localize 'HOGWARTS.Item.Feature.PerkType.none'}}</option>
      <option value='fateBoon' {{#if (eq system.perkType 'fateBoon')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.FateBoon'}}</option>
      <option value='fateBane' {{#if (eq system.perkType 'fateBane')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.FateBane'}}</option>
      <option value='advantage' {{#if (eq system.perkType 'advantage')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.Advantages'}}</option>
      <option value='disadvantage' {{#if (eq system.perkType 'disadvantage')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.Disadvantages'}}</option>
      <option value='abilityNatural' {{#if (eq system.perkType 'abilityNatural')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.NaturalAbilities'}}</option>
      <option value='abilitySpecial' {{#if (eq system.perkType 'abilitySpecial')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.SpecialAbilities'}}</option>
      <option value='houseAxiom' {{#if (eq system.perkType 'houseAxiom')}}selected{{/if}}>{{localize 'HOGWARTS.Perks.HouseAxioms'}}</option>
    </select>
  </div>

  <div class='form-group'>
    <label>{{localize 'HOGWARTS.Item.Feature.PBPCost'}}</label>
    <input
      type='number'
      name='system.pbpCost'
      value='{{system.pbpCost}}'
      step='0.5'
      data-dtype='Number'
    />
  </div>
</section>