{{! Attributes Tab }}
<section
  class='tab attributes {{tab.cssClass}}'
  data-group='primary'
  data-tab='attributes'
>
  {{! As you add new fields, add them in here! }}
  <div class='resource'>
    <label class='resource-label'>{{localize 'HOGWARTS.Currency.Title'}}:</label>
    <div class='grid grid-3col'>
      <div class='grid-span-1'>
        <label class='resource-label'>{{localize 'HOGWARTS.Currency.Galleons'}}</label>
        <input
          type='number'
          name='system.cost.galleons'
          value='{{system.cost.galleons}}'
          min='0'
          data-dtype='Number'
        />
      </div>
      <div class='grid-span-1'>
        <label class='resource-label'>{{localize 'HOGWARTS.Currency.Sickles'}}</label>
        <input
          type='number'
          name='system.cost.sickles'
          value='{{system.cost.sickles}}'
          min='0'
          data-dtype='Number'
        />
      </div>
      <div class='grid-span-1'>
        <label class='resource-label'>{{localize 'HOGWARTS.Currency.Knuts'}}</label>
        <input
          type='number'
          name='system.cost.knuts'
          value='{{system.cost.knuts}}'
          min='0'
          data-dtype='Number'
        />
      </div>
    </div>
  </div>

  <div class='form-group'>
    <label>{{localize 'HOGWARTS.Item.Gear.FIELDS.quantity.label'}}</label>
    <input
      type='number'
      name='system.quantity'
      value='{{system.quantity}}'
      min='0'
      step='1'
      data-dtype='Number'
    />
  </div>

  <div class='form-group'>
    <label>{{localize 'HOGWARTS.Item.Gear.FIELDS.weight.label'}}</label>
    <input
      type='number'
      name='system.weight'
      value='{{system.weight}}'
      min='0'
      step='any'
      data-dtype='Number'
    />
  </div>

  <div class='form-group'>
    <label>{{localize 'HOGWARTS.Item.Feature.PBPCost'}}</label>
    <input
      type='number'
      name='system.pbpCost'
      value='{{system.pbpCost}}'
      step='0.5'
      data-dtype='Number'
    />
  </div>
</section>